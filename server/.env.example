DATABASE_URL=postgres://user:password@localhost:5432/shieldai
# Optional — a least-privilege role for the app's own runtime queries,
# distinct from the (super)user DATABASE_URL uses for migrations. Only
# relevant if you've provisioned one yourself; falls back to DATABASE_URL
# otherwise, which is fine for local dev. The docker-compose deployment
# sets this automatically (server/scripts/init-app-role.sh).
APP_DATABASE_URL=
PORT=3000

JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173

# Optional — only needed for SSO login
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Optional — unset means verification links are logged to stdout instead
# of emailed (fine for local/pilot use, not for real users)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ShieldAI <no-reply@shieldai.local>
SMTP_SECURE=false
