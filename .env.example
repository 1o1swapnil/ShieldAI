POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
JWT_SECRET=change-me-to-a-long-random-string

WEB_ORIGIN=http://localhost:8080
VITE_API_BASE=http://localhost:3000

# Optional — only needed for SSO login
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Optional — unset means verification links are logged to stdout instead
# of emailed (fine for local/pilot use, not for real users)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ShieldAI <no-reply@shieldai.local>
SMTP_SECURE=false
